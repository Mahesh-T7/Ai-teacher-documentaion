# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/teacher_portal?retryWrites=true&w=majority
# Example Local MongoDB URI:
MONGODB_URI=mongodb://127.0.0.1:27017/teacher_portal

# JWT Authentication Secret and Expiration
JWT_SECRET=your_jwt_secret_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
